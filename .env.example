# URL de l'API.
# - En attendant les controleurs Produits/Commandes du Backend : le mock
#   json-server du depot (npm run api), au format exact du Manager.
# - Quand Backend_RestoApp les expose : http://localhost:8080/api/v1
# - Test via un tunnel (VS Code, ngrok) ou depuis un telephone : /api-mock
#   (relaye vers le mock par le serveur Vite, voir vite.config.js).
VITE_API_BASE_URL=http://localhost:3101

# Contact support (feuille "Besoin d'aide ?" en bas de page).
VITE_SUPPORT_TELEPHONE=+221770000000
VITE_SUPPORT_EMAIL=support@senyummies.sn

# --- Docker (docker-compose.yml) -------------------------------------------
# Ces variables-la sont lues AU DEMARRAGE du conteneur, pas a la compilation.
# CLIENT_PORT=8081
# CLIENT_API_BASE_URL=/api-mock   # /api/v1 avec le vrai backend
# API_UPSTREAM=http://host.docker.internal:8080
# SUPPORT_TELEPHONE=+221770000000
# SUPPORT_EMAIL=support@senyummies.sn
