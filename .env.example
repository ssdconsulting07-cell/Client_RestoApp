# URL de l'API.
# - Vrai backend (Backend_RestoApp, docker compose up, port 8080) : /api/v1,
#   relaye par le serveur Vite (voir vite.config.js) : fonctionne aussi via
#   un tunnel (VS Code, ngrok) ou depuis un telephone du reseau local.
# - Mock de demonstration sans backend (npm run api) : /api-mock.
VITE_API_BASE_URL=/api/v1

# Contact support (feuille "Besoin d'aide ?" en bas de page).
VITE_SUPPORT_TELEPHONE=+221770000000
VITE_SUPPORT_EMAIL=support@senyummies.sn

# Marque du restaurant (marque blanche). Vide = SenYummies.
# En developpement : VITE_MARQUE_* ; en Docker : MARQUE_* (sans VITE_), lues
# au demarrage du conteneur.
# VITE_MARQUE_NOM=Chez Fatou
# VITE_MARQUE_NOM_ACCENT=Fatou        # fin du nom dans la couleur de marque
# VITE_MARQUE_INITIALES=CF            # monogramme (defaut : deduit du nom)
# VITE_MARQUE_LOGO_URL=               # image qui remplace le monogramme
# VITE_MARQUE_SLOGAN=Le goût du pays, à chaque bouchée.
# VITE_MARQUE_SOUS_TITRE=Commande en ligne · Thiès
# VITE_MARQUE_COULEUR=#1F6F57          # couleur principale (#RRGGBB)
# VITE_MARQUE_COULEUR_CLAIRE=          # accent sur fond sombre (defaut : calcule)

# --- Docker (docker-compose.yml) -------------------------------------------
# Ces variables-la sont lues AU DEMARRAGE du conteneur, pas a la compilation.
# CLIENT_PORT=8081
# CLIENT_API_BASE_URL=/api/v1    # /api-mock pour le mock de demonstration
# API_UPSTREAM=http://host.docker.internal:8080
# SUPPORT_TELEPHONE=+221770000000
# SUPPORT_EMAIL=support@senyummies.sn
# MARQUE_NOM=, MARQUE_COULEUR=... : memes champs que VITE_MARQUE_* ci-dessus
# APP_VERSION=v1.2.0               # version affichee (sinon package.json)
