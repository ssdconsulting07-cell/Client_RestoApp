# URL de l'API.
# - Vrai backend (Backend_RestoApp, docker compose up, port 8080) : /api/v1,
#   relaye par le serveur Vite (voir vite.config.js) : fonctionne aussi via
#   un tunnel (VS Code, ngrok) ou depuis un telephone du reseau local.
# - Mock de demonstration sans backend (npm run api) : /api-mock.
VITE_API_BASE_URL=/api/v1

# Contact support (feuille "Besoin d'aide ?" en bas de page).
VITE_SUPPORT_TELEPHONE=+221770000000
VITE_SUPPORT_EMAIL=support@senyummies.sn

# --- Docker (docker-compose.yml) -------------------------------------------
# Ces variables-la sont lues AU DEMARRAGE du conteneur, pas a la compilation.
# CLIENT_PORT=8081
# CLIENT_API_BASE_URL=/api/v1    # /api-mock pour le mock de demonstration
# API_UPSTREAM=http://host.docker.internal:8080
# SUPPORT_TELEPHONE=+221770000000
# SUPPORT_EMAIL=support@senyummies.sn
